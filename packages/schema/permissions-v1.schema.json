{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentos.dev/schema/permissions-v1.schema.json",
  "title": "AgentOS Agent Package permission declarations (permissions.json)",
  "type": "object",
  "required": ["permissions"],
  "additionalProperties": false,
  "properties": {
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["permission"],
        "additionalProperties": false,
        "properties": {
          "permission": {
            "description": "Must match one of the 11 fine-grained AgentOS permissions.",
            "enum": [
              "filesystem.read",
              "filesystem.write",
              "network",
              "microphone",
              "camera",
              "gpu.compute",
              "system.settings",
              "process.execute",
              "agent.invoke",
              "memory.read",
              "memory.write"
            ]
          },
          "access": { "enum": ["read", "write"] },
          "resource": { "type": "string", "maxLength": 4096 },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "description": "Human-readable justification surfaced in the permission dialog."
          }
        }
      }
    }
  }
}
